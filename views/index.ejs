<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('header') %>

    <div class="container mt-4">
        <h2 class="mb-3">Assignments</h2>

        <div class="mb-3">
            <a href="/add" class="btn btn-primary">Add Assignment</a>
        </div>

        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% assignments.forEach(a => { %>
                <tr>
                    <td><%= a.title %></td>
                    <td><%= a.subject %></td>
                    <td><%= a.dueDate %></td>
                    <td>
                        <% if(a.status === 'Pending') { %>
                            <span class="badge bg-warning text-dark">Pending</span>
                        <% } else { %>
                            <span class="badge bg-success">Completed</span>
                        <% } %>
                    </td>
                    <td>
                        <a href="/edit/<%= a.id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form action="/delete/<%= a.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Bootstrap JS Bundle (optional for components) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>